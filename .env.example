# Local development only. Compose binds PostgreSQL to loopback.
DATABASE_URL=postgres://convex:convex@127.0.0.1:5432/convex
TEST_DATABASE_URL=postgres://convex:convex@127.0.0.1:5433/convex_test
CONVEX_BIND_ADDRESS=127.0.0.1:3000
RUST_LOG=info,tower_http=debug

# Required only for first-admin setup; use a random value of at least 32 characters.
# CONVEX_SETUP_TOKEN=replace-with-a-random-installer-secret
# Exact browser origin; HTTPS required except on loopback development hosts.
CONVEX_PUBLIC_URL=http://127.0.0.1:5173
# Shared absolute session lifetime for local and OIDC login, default seven days.
# Stop all replicas before changing authentication settings, then restart them together.
# Shortening caps existing sessions; increasing applies only to newly issued sessions.
# CONVEX_SESSION_TTL_SECONDS=604800
# One installation-level OIDC provider; login and invitation onboarding are available.
# Register the exact callback: ${CONVEX_PUBLIC_URL}/api/v1/auth/oidc/callback.
# CONVEX_OIDC_ISSUER_URL=https://identity.example.com/realms/convex
# CONVEX_OIDC_CLIENT_ID=convex
# CONVEX_OIDC_CLIENT_SECRET=replace-with-your-provider-client-secret
# CONVEX_OIDC_DISPLAY_NAME=Company login
# CONVEX_OIDC_ENABLED=true
# Enforce OIDC for ordinary users; local admins retain recovery access.
# Linking existing local accounts remains a separate CP03 slice.
# CONVEX_OIDC_REQUIRED=false
# Optional SMTP. STARTTLS is the default. Plain SMTP is restricted to local hosts.
# CONVEX_SMTP_HOST=127.0.0.1
# CONVEX_SMTP_PORT=1025
# CONVEX_SMTP_TLS=plain
# CONVEX_SMTP_FROM="Convex <convex@example.com>"
# CONVEX_SMTP_USERNAME=
# CONVEX_SMTP_PASSWORD=
