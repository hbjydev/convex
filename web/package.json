{
  "name": "@convex/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsr generate && tsc --noEmit && vite build",
    "typecheck": "tsr generate && tsc --noEmit",
    "routes:generate": "tsr generate",
    "generate": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "lint": "cd .. && oxlint --config web/.oxlintrc.json --deny-warnings web api scripts",
    "lint:fix": "pnpm lint --fix",
    "format": "cd .. && oxfmt --config web/.oxfmtrc.json --write web api scripts",
    "format:check": "cd .. && oxfmt --config web/.oxfmtrc.json --check web api scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-router": "1.170.41",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.40",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
