{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "convex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicUrl", "port", "existingSecret", "config"],
      "properties": {
        "publicUrl": {
          "type": "string",
          "description": "Exact browser origin; empty until configured.",
          "pattern": "^$|^https://[^/?#@\\s]+/?$|^http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?/?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "existingSecret": { "type": "string" },
        "config": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": {
            "type": ["string", "number", "boolean", "object", "null"]
          },
          "not": {
            "anyOf": [
              { "required": ["CONVEX_PUBLIC_URL"] },
              { "required": ["CONVEX_BIND_ADDRESS"] }
            ]
          }
        }
      }
    }
  }
}
